# ==========================================
# DO OR DIE — Environment Variables Template
# ==========================================
# NOTE: This file is tracked in git. NEVER put real secrets here!
# Copy this file to .env.local for local development, and configure
# real secret values in the Vercel Dashboard for production.

# 1. Database Connection (PostgreSQL 16)
# Cloud connection string (Vercel Postgres, Neon, Supabase)
# Leave empty for local development to use embedded WASM PostgreSQL 16 (.data/pglite)
POSTGRES_URL="postgresql://user:password@host:5432/database?sslmode=require"

# 2. Master PIN Authentication & Session Security
# Required in production: The app strictly blocks '1234' on public URLs.
# Recommended: Generate a salted hash via `npm run hash-pin <your-pin>`
APP_PIN_HASH="generate-with-npm-run-hash-pin"

# Alternative: Provide a raw custom PIN (will be hashed with constant-time equality checks)
APP_PIN="your-custom-4-to-6-digit-pin"

# Session Token HMAC-SHA256 Signing Secret
# Required in production. Generate a random 64+ char string (e.g., `openssl rand -hex 32`)
SESSION_SECRET="generate-a-random-64-char-string"

# 3. Web Push Notifications (VAPID Keypair)
# Generate a permanent fixed keypair via `npm run generate-vapid`
# Put the generated values in your local .env.local and Vercel dashboard.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="generate-with-npm-run-generate-vapid"
VAPID_PRIVATE_KEY="generate-with-npm-run-generate-vapid"
VAPID_SUBJECT="mailto:your-email@example.com"

# 4. Cron Authorization Secret
# Protects /api/cron/* endpoints against unauthorized public invocations
CRON_SECRET="generate-a-random-32-char-string"
